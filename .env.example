# ============================================================
# System Monitoring - variables d'environnement
# Copier ce fichier vers .env et renseigner les valeurs réelles.
# NE JAMAIS committer le fichier .env.
# ============================================================

# --- Oracle Database (instance existante, conteneur "oracle-pfe") ---
ORACLE_USER=MONITOR_APP
ORACLE_PASSWORD=change_me
ORACLE_DSN=localhost:1521/XEPDB1

# --- Bootstrap uniquement : création de l'utilisateur applicatif ---
# (utilisé une seule fois par storage/db.py, jamais par l'API)
SYS_USER=SYS
SYS_PASSWORD=change_me

# --- Telegram (optionnel à l'étape 1 ; requis à l'étape 4) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Surveillance ---
COLLECT_INTERVAL_SECONDS=10
CONFIRM_SAMPLES=3

# Seuils (pourcentages) : WARNING / CRITICAL
THRESHOLD_CPU_WARNING=75
THRESHOLD_CPU_CRITICAL=90
THRESHOLD_RAM_WARNING=80
THRESHOLD_RAM_CRITICAL=95
THRESHOLD_DISK_WARNING=80
THRESHOLD_DISK_CRITICAL=95

# Chemin du disque à surveiller
DISK_PATH=/
